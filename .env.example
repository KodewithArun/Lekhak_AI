# Lekhak AI Environment Configuration

# ===========================================
# Google Gemini API Configuration
# ===========================================
# Get your API key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Use Vertex AI (0 = No, use AI Studio | 1 = Yes, use Vertex AI)
GOOGLE_GENAI_USE_VERTEXAI=0

# ===========================================
# Database Configuration (PostgreSQL)
# ===========================================
# Format: postgresql://username:password@host:port/database_name
# Example: postgresql://lekhak_user:password123@localhost:5432/lekhak_db
DB_URL=postgresql://postgres:postgres@localhost:5432/lekhak_db

# ===========================================
# Application Configuration
# ===========================================
# Application name for Google ADK session management
APP_NAME=lekhak_ai

# Default user ID for Streamlit sessions
USER_ID=streamlit_user

# ===========================================
# Optional: Model Configuration
# ===========================================
# Uncomment to override default model (gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_MODEL=gemini-2.0-pro

# ===========================================
# Optional: Logging
# ===========================================
# LOG_LEVEL=INFO
# LOG_FILE=logs/lekhak.log
