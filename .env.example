# ============================================================
# Lekhak AI - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ----------------------------------------------------------
# Google API Configuration (Required)
# ----------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ----------------------------------------------------------
# SerpAPI Configuration (Required)
# ----------------------------------------------------------
SERPAPI_API_KEY=your_serpapi_key_here
SERPAPI_BASE_URL=https://serpapi.com/search.json

# ----------------------------------------------------------
# Application Configuration
# ----------------------------------------------------------
APP_NAME=Lekhak_AI
USER_ID=test_user

# ----------------------------------------------------------
# PostgreSQL Database Configuration
# ----------------------------------------------------------
# When running with Docker, DB_HOST is automatically set to 'postgres'
# For local development without Docker, use 'localhost'
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lekhak_ai
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# ----------------------------------------------------------
# API Configuration
# ----------------------------------------------------------
API_BASE_URL=http://localhost:8000/api

# ----------------------------------------------------------
# pgAdmin Configuration (Development only)
# ----------------------------------------------------------
# PGADMIN_EMAIL=admin@lekhak.ai
# PGADMIN_PASSWORD=admin